POSTGRES_VERSION=18.6
RABBITMQ_VERSION=4.4.0-management
GARAGE_VERSION=v2.3.0
KEYCLOAK_VERSION=26.8.1
VAULT_VERSION=2.2.1

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_PORT=5432

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

REDIS_VERSION=8.10.3
REDIS_PORT=6379

MONGODB_VERSION=9.0.4
MONGODB_ROOT_USER=root
MONGODB_ROOT_PASSWORD=root
MONGODB_PORT=27017

VAULT_DEV_ROOT_TOKEN=root
VAULT_PORT=8200
VAULT_ADDR=http://localhost:8200

RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_HTTP_PORT=15672

KAFKA_VERSION=4.4.0
KAFKA_PORT=9092
KAFKA_NODE_ID=1
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092

GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_WEB_ROOT_DOMAIN=localhost
GARAGE_ADMIN_PORT=3903
GARAGE_ADMIN_TOKEN=replace-with-random-token
GARAGE_METRICS_TOKEN=replace-with-random-token
GARAGE_DEFAULT_ACCESS_KEY=replace-access-key
GARAGE_DEFAULT_SECRET_KEY=replace-secret-key
GARAGE_DEFAULT_BUCKET=default
